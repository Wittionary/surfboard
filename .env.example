ADO_ORG=<your-organization>
ADO_PROJECT=<your-project>
ADO_PAT=<your-pat>

# Local-dev paths, used by `bun run dev`. docker-compose.yml pins these to
# /workspace and /workspace/templates inside the container regardless.
ADO_WORKSPACE_DIR=./workspace
ADO_TEMPLATE_DIR=./workspace/templates

# Container-only settings. Ignored by `bun run dev`.
# Host port the app is published on. The container always listens on 3000.
SURFBOARD_PORT=3000
# Match your host user (`id -u`, `id -g`) so bind-mounted YAML stays editable.
HOST_UID=1000
HOST_GID=1000
# 0/false/off forces native filesystem events. Leave unset (polling) in
# containers — Docker Desktop bind mounts do not emit reliable native events.
# SURFBOARD_WATCH_POLLING=0
