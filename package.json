{
  "name": "surfboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server/index.ts",
    "build": "bun run scripts/build-frontend.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "verify:phase1": "bun run scripts/verify-phase1.ts",
    "verify:phase2": "bun run scripts/verify-phase2.ts",
    "verify:phase3": "bun run scripts/verify-phase3.ts",
    "verify:phase4": "bun run scripts/verify-phase4.ts",
    "verify:phase5": "bun run scripts/verify-phase5.ts",
    "verify:mvp": "bun run scripts/verify-mvp.ts",
    "verify:container": "bun run scripts/verify-container.ts",
    "smoke:ado-read": "bun run scripts/smoke-ado-read.ts",
    "smoke:ado-write": "bun run scripts/smoke-ado-write.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "chokidar": "5.0.0",
    "fastify": "5.12.1",
    "pino": "10.3.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.2"
  }
}
